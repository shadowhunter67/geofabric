{
  "name": "geofabric-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lowering && tsc --noEmit && vite build",
    "typecheck": "npm run lowering && tsc --noEmit",
    "e2e": "playwright test",
    "test": "node --test test/*.test.ts",
    "build:static": "npm run lowering && tsc --noEmit && vite build --mode static && node scripts/copy-demo.mjs",
    "lowering": "node scripts/build-lowering-wasm.mjs",
    "pretest": "npm run lowering"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "geotiff": "3.0.5",
    "maplibre-gl": "^6.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/geojson": "^7946.0.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
