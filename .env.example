# Example configuration for the OPTIONAL PostGIS engine. Copy to a real .env (never committed) and fill in your own values.
# The static public demo and the default local stack need none of this.

# set to 1 to register the PostGIS engine (anything else = no engine, no probe, no error)
GEOFABRIC_POSTGIS_ENABLED=0
# runtime account: SELECT only. Placeholders only - never commit a real password.
GEOFABRIC_POSTGIS_URL=postgres://gf_reader:CHANGE_ME@127.0.0.1:5433/geofabric
# the source catalog written by scripts/postgis/load_data.py
GEOFABRIC_POSTGIS_SOURCES=data/manifests/postgis-sources.json
# connection pool size (1-32)
GEOFABRIC_POSTGIS_POOL=4
